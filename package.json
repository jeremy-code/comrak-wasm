{
    "name": "comrak-wasm",
    "version": "0.0.1",
    "private": true,
    "license": "BSD-2-Clause",
    "scripts": {
        "prepare": "prek install",
        "lint": "cargo clippy --all-targets --all-features",
        "format": "oxfmt && cargo fmt --all",
        "format:check": "oxfmt --check && cargo fmt --all --check",
        "build": "wasm-pack build --target web --release",
        "dev": "wasm-pack build --target web --dev",
        "ci:version": "changeset version && pnpm pkg get version | xargs cargo set-version",
        "ci:publish": "pnpm stage publish pkg"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@j178/prek": "^0.4.13",
        "oxfmt": "^0.62.0",
        "wasm-pack": "^0.15.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.20.0",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "^24.19.0",
            "onFail": "download"
        }
    }
}
