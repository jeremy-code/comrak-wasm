{
    "name": "comrak-wasm",
    "version": "0.0.11",
    "private": true,
    "license": "BSD-2-Clause",
    "scripts": {
        "prepare": "prek install",
        "lint": "cargo clippy --all-targets --all-features",
        "format": "oxfmt && cargo fmt --all",
        "format:check": "oxfmt --check && cargo fmt --all --check",
        "build": "wasm-pack build --target web --release --panic-unwind",
        "dev": "wasm-pack build --target web --dev",
        "test": "wasm-pack test --node",
        "ci:version": "changeset version && pnpm pkg get version | xargs cargo set-version",
        "ci:publish": "./scripts/publish.sh"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/types": "^21.2.3",
        "@j178/prek": "^0.5.5",
        "binaryen": "^132.0.0",
        "oxfmt": "^0.72.0",
        "wasm-pack": "^0.15.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.9.1",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "^24.21.0",
            "onFail": "download"
        }
    }
}
